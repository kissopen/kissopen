# Community-only mobile settings. No secrets belong in EXPO_PUBLIC_* variables.
COMMUNITY_APP_ENV=development
# Leave EAS unset to disable OTA. Do not reuse commercial EAS project IDs.
# COMMUNITY_EAS_PROJECT_ID=
# COMMUNITY_EXPO_OWNER=
# COMMUNITY_APP_LINK_HOST=
# COMMUNITY_APPLE_TEAM_ID=
# COMMUNITY_GOOGLE_SERVICES_FILE=

# Local simulator development; physical devices need their own reachable HTTPS origin.
EXPO_PUBLIC_COMMUNITY_RELAY_URL=http://127.0.0.1:3005
# Enable social login buttons for the same relay; provider secrets are server-only.
# Production: set BOTH relay and account URLs to https://kissopen.com.
# EXPO_PUBLIC_COMMUNITY_ACCOUNT_URL=http://127.0.0.1:3005
# EXPO_PUBLIC_COMMUNITY_LOG_SERVER_URL=
